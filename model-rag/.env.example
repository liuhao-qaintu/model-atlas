MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=model_rag
# 独立运行模板：填写自己的密钥和数据库密码；密钥不会发送到前端。
LLM_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
RERANK_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=

# 认证签名密钥至少32字符，只保存在服务端；已有配置不要覆盖。
AUTH_SECRET_KEY=
AUTH_EXPIRE_HOURS=24
AUTH_COOKIE_SECURE=false
ENABLE_API_DOCS=false
# 维护接口同时要求admin角色和此处ID白名单。
MAINTAINER_USER_IDS=[]
